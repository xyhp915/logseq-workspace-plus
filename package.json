{
  "name": "logseq-workspace-plus",
  "version": "0.0.0",
  "description": "A Logseq plugin for workspace plus.",
  "scripts": {
    "dev": "parcel watch ./index.html --public-url ./ & ./node_modules/.bin/http-server ./dist",
    "build": "rm -rf .parcel-cache && parcel build ./index.html --public-url .",
    "playground:vite": "vite ./playground"
  },
  "author": "charlie",
  "license": "MIT",
  "private": false,
  "logseq": {
    "main": "dist/index.html",
    "id": "_logseq_workspace_plus"
  },
  "dependencies": {
    "@logseq/libs": "0.0.17",
    "immer": "^10.0.4",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "uniqid": "^5.4.0",
    "use-immer": "^0.9.0"
  },
  "alias": {
    "react/jsx-dev-runtime": "./node_modules/react/jsx-dev-runtime.js",
    "react/jsx-runtime": "./node_modules/react/jsx-runtime.js",
    "react": "./src/react.js",
    "react-dom": "./src/react-dom.js"
  },
  "devDependencies": {
    "@types/react": "17.0.79",
    "@types/react-dom": "17.0.9",
    "@types/uniqid": "^5.3.4",
    "@vitejs/plugin-react": "^4.2.1",
    "assert": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "console-browserify": "^1.2.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.1",
    "os-browserify": "^0.3.0",
    "parcel": "2.11.0",
    "postcss": "^8.4.38",
    "postcss-nesting": "^12.1.0",
    "tailwindcss": "^3.4.1",
    "util": "^0.12.3",
    "vite": "^5.2.2",
    "vitest": "^1.4.0"
  }
}
